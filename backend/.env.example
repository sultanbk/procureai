# LLM Provider Configuration (vertex, omniroute, groq, gemini)
LLM_PROVIDER=vertex

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=supplierguard
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
VERTEX_MODEL=gemini-2.5-flash


# Groq (Free/Fast Alternative - get API key from console.groq.com)
# Free tier: 100 requests/minute, ~700K tokens/day
GROQ_API_KEY=your-groq-api-key
# Recommended: openai/gpt-oss-120b (reasoning), llama-3.3-70b-versatile (balanced), llama-3.1-8b-instant (fastest)
GROQ_MODEL=openai/gpt-oss-120b

# Database
DATABASE_URL=sqlite:///./data/procureai.db

# File storage
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=20

# Pipeline settings
MINIMUM_MATERIAL_THRESHOLD=100
COMPLIANCE_CONFIDENCE_THRESHOLD=0.60
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_DELAY_SECONDS=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=CONSOLE
LOG_FILE=logs/app.log

# Runtime
MOCK_LLM=true
ALLOW_MOCK_LLM=true
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
PROCUREAI_API_KEY=
REQUIRE_API_KEY=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Encryption (for SMTP passwords stored in DB)
# If not set, a machine-derived key is used automatically. Set this for production.
PROCUREAI_ENCRYPTION_KEY=

# Frontend
VITE_API_URL=http://localhost:8000
